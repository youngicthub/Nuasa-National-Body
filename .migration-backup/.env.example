# =====================================================================
# Environment variables — copy to .env and fill in your own values.
# =====================================================================
# These are the variables the app expects at build/runtime.
# In Lovable Cloud projects these are auto-injected; this file is only
# needed when running the project locally outside Lovable.
# =====================================================================

VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_URL="https://your-supabase-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
