# =====================================================================
# NUASA National E-Library — Environment Variables
# =====================================================================
# Copy this file to .env and fill in your own values.
# The .env file must never be committed to version control.
# =====================================================================

# ─── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# Port the API server listens on
PORT=5000

# ─── Database (MySQL) ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nuasa_database
DB_USER=root
DB_PASSWORD=

# ─── Authentication ───────────────────────────────────────────────────────────
# Long random string used to sign JWTs — keep this secret
JWT_SECRET=replace_with_a_long_random_secret

# Secret required to create admin accounts via /api/auth/admin-signup
# Never expose this to the frontend
ADMIN_SIGNUP_SECRET=replace_with_secure_secret

# ─── URLs ─────────────────────────────────────────────────────────────────────
# Used in email links (verification, password reset)
# Local development:
FRONTEND_URL=http://localhost:5173
# Production (set this when deploying):
# FRONTEND_URL=http://nuasanational.com.ng

# Vite frontend env (only VITE_ prefix is exposed to the browser)
VITE_API_URL=http://localhost:5000/api

# ─── SMTP / Email ─────────────────────────────────────────────────────────────
# Leave SMTP_HOST blank to disable email sending (tokens will still be
# generated and logged to the console in development).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password_or_app_password

MAIL_FROM_NAME=NUASA National Body
MAIL_FROM_EMAIL=your_email@example.com

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ─── Payments (Flutterwave) ───────────────────────────────────────────────────
FLUTTERWAVE_PUBLIC_KEY=
