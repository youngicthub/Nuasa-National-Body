# ─────────────────────────────────────────────────────────────────────────────
# NUASA National E-Library — local development environment variables
# Copy this file to .env and fill in your values.
# .env is git-ignored; never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── API server port (Vite proxy target) ──────────────────────────────────────
PORT=8080

# ── MySQL connection ─────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nuasa_database
DB_USER=root
DB_PASSWORD=

# ── Auth secrets (change these!) ──────────────────────────────────────────────
# Required at startup — the server refuses to boot if either is unset or
# shorter than 32 characters. Generate distinct values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
ADMIN_SIGNUP_SECRET=change-me-to-a-different-long-random-string

# ── Frontend origin (used for CORS and email links) ──────────────────────────
FRONTEND_URL=http://localhost:5173

# ── File uploads ─────────────────────────────────────────────────────────────
# Directory where uploaded files are stored (relative to api-server working dir)
UPLOAD_DIR=uploads

# ── Email / SMTP (optional — leave blank to skip email sending) ──────────────
# SMTP_HOST=smtp.example.com      ← must be a hostname, NOT an email address
# SMTP_PORT=587
# SMTP_SECURE=false               ← set true for port 465
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-smtp-password
# MAIL_FROM_NAME=NUASA
# MAIL_FROM_EMAIL=noreply@example.com
